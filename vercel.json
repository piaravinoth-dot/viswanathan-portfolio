{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/work/:slug/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/resume/Viswanathan_G_Resume.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Viswanathan_G_Resume.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
