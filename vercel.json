{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work/ai-design-studio",
      "destination": "/case-study-pages/ai-design-studio.html"
    },
    {
      "source": "/work/content-studio",
      "destination": "/case-study-pages/content-studio.html"
    },
    {
      "source": "/work/social-media-intelligence",
      "destination": "/case-study-pages/social-media-intelligence.html"
    },
    {
      "source": "/work/content-tracker",
      "destination": "/case-study-pages/content-tracker.html"
    },
    {
      "source": "/work/splitmate",
      "destination": "/case-study-pages/splitmate.html"
    },
    {
      "source": "/work/clip-studio",
      "destination": "/case-study-pages/clip-studio.html"
    },
    {
      "source": "/work/nation-building",
      "destination": "/case-study-pages/nation-building.html"
    },
    {
      "source": "/work/telangana-manifesto",
      "destination": "/case-study-pages/telangana-manifesto.html"
    },
    {
      "source": "/work/led-rath-yatra",
      "destination": "/case-study-pages/led-rath-yatra.html"
    },
    {
      "source": "/work/samvidhan",
      "destination": "/case-study-pages/samvidhan.html"
    },
    {
      "source": "/journey",
      "destination": "/journey/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/resume/Viswanathan_G_Resume.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Viswanathan_G_Resume.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/portfolio-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-study-pages/ai-design-studio.html",
      "destination": "/work/ai-design-studio",
      "permanent": true
    },
    {
      "source": "/case-study-pages/content-studio.html",
      "destination": "/work/content-studio",
      "permanent": true
    },
    {
      "source": "/case-study-pages/social-media-intelligence.html",
      "destination": "/work/social-media-intelligence",
      "permanent": true
    },
    {
      "source": "/case-study-pages/content-tracker.html",
      "destination": "/work/content-tracker",
      "permanent": true
    },
    {
      "source": "/case-study-pages/splitmate.html",
      "destination": "/work/splitmate",
      "permanent": true
    },
    {
      "source": "/case-study-pages/clip-studio.html",
      "destination": "/work/clip-studio",
      "permanent": true
    },
    {
      "source": "/case-study-pages/nation-building.html",
      "destination": "/work/nation-building",
      "permanent": true
    },
    {
      "source": "/case-study-pages/telangana-manifesto.html",
      "destination": "/work/telangana-manifesto",
      "permanent": true
    },
    {
      "source": "/case-study-pages/led-rath-yatra.html",
      "destination": "/work/led-rath-yatra",
      "permanent": true
    },
    {
      "source": "/case-study-pages/samvidhan.html",
      "destination": "/work/samvidhan",
      "permanent": true
    }
  ]
}
